//@version=6
indicator("Confluence Scorecard Oscillator", shorttitle = "CONF-OSC", overlay = false, max_lines_count = 200, max_labels_count = 200)

// Confluence Scorecard Oscillator
// 1) Squeeze momentum histogram: the linear regression over N bars of the close minus the average of two
//    values, the midpoint of the highest high and the lowest low, and the SMA of the close. Its color gives the
//    direction (above or below zero, rising or falling) and its transparency the strength, from the ADX.
// 2) Squeeze state on the zero line: on while the Bollinger Bands sit inside the Keltner Channel, off
//    otherwise, and the release bar, the first bar off after a squeeze.
// 3) Regular divergences between price and momentum, from momentum pivots. Each mark is drawn back at its
//    pivot and its tooltip says how many bars later it was confirmed.
// 4) Triangles where momentum crosses zero, and alert conditions for the crosses and the release.
// Dots, triangles and divergence marks are set on closed bars only. No request.security call.

// ───────────────────────── Inputs ─────────────────────────
const string gMom = "Momentum"
const string gSqz = "Squeeze"
const string gAdx = "Strength (ADX)"
const string gDiv = "Divergences"

momLen = input.int(20, "Length", minval = 2, group = gMom, tooltip = "Bars of the highest high, the lowest low and the SMA of the close, and of the linear regression. The main script's vote 4 uses the same formula.")

bbLen = input.int(20, "Bollinger length", minval = 2, group = gSqz)
bbMult = input.float(2.0, "Bollinger multiplier", minval = 0.1, step = 0.1, group = gSqz, tooltip = "Bollinger Bands: SMA of the close +- multiplier x standard deviation of the close.")
kcLen = input.int(20, "Keltner length", minval = 2, group = gSqz)
kcMult = input.float(1.5, "Keltner multiplier", minval = 0.1, step = 0.1, group = gSqz, tooltip = "Keltner Channel: SMA of the close +- multiplier x SMA of the true range. The squeeze is on while both Bollinger Bands sit inside the channel.")

diLen = input.int(14, "DI length", minval = 1, group = gAdx)
adxSmooth = input.int(14, "ADX smoothing", minval = 1, group = gAdx)
adxThr = input.float(25.0, "ADX threshold", minval = 1, step = 1, group = gAdx, tooltip = "At or above the threshold the histogram is opaque; below it, transparency = 70 x (1 - ADX / threshold), up to 70 at an ADX of 0.")

divOn = input.bool(true, "Show divergences", group = gDiv)
divLeft = input.int(5, "Pivot left bars", minval = 1, maxval = 50, group = gDiv)
divRight = input.int(5, "Pivot right bars", minval = 1, maxval = 50, group = gDiv, tooltip = "A momentum pivot confirms this many bars after its bar; the mark is drawn back at the pivot on the bar that confirms it.")
divMin = input.int(5, "Min bars between pivots", minval = 1, group = gDiv)
divMax = input.int(60, "Max bars between pivots", minval = 2, group = gDiv)
divKeep = input.int(50, "Divergences kept", minval = 1, maxval = 100, group = gDiv, tooltip = "The oldest marks beyond this number are deleted.")

// ───────────────────────── Momentum and strength ─────────────────────────
// Called on every bar at the global scope, so their history is consistent.
float sqzMid = math.avg(math.avg(ta.highest(high, momLen), ta.lowest(low, momLen)), ta.sma(close, momLen))
float mom = ta.linreg(close - sqzMid, momLen, 0)
[diPlus, diMinus, adx] = ta.dmi(diLen, adxSmooth)

color upStrong = #26a69a
color upWeak = #80cbc4
color dnStrong = #ef5350
color dnWeak = #ef9a9a

// Direction: zero or above and rising (dark teal), zero or above and not rising (light teal), below zero and
// rising (light red), below zero and not rising (dark red). Rising means above the previous bar's value.
// Strength: opaque at or above the ADX threshold, fading below it.
bool rising = mom > mom[1]
color momCol = mom >= 0 ? (rising ? upStrong : upWeak) : (rising ? dnWeak : dnStrong)
int transp = na(adx) ? 70 : math.round(70 * (1 - math.min(adx / adxThr, 1)))
plot(mom, "Momentum", color = color.new(momCol, transp), style = plot.style_columns)
hline(0, "Zero", color = color.new(color.gray, 50), linestyle = hline.style_dotted)

// ───────────────────────── Squeeze state ─────────────────────────
float bbBasis = ta.sma(close, bbLen)
float bbDev = bbMult * ta.stdev(close, bbLen)
float kcBasis = ta.sma(close, kcLen)
float kcRange = kcMult * ta.sma(ta.tr(true), kcLen)
bool sqzOn = bbBasis - bbDev > kcBasis - kcRange and bbBasis + bbDev < kcBasis + kcRange
bool release = sqzOn[1] and not sqzOn
// Orange while the squeeze is on, blue on the release bar, gray otherwise. The forming bar has no dot until it
// closes.
color sqzCol = release ? #2962ff : sqzOn ? #ff9800 : color.gray
plot(0, "Squeeze state", color = barstate.isconfirmed ? sqzCol : na, style = plot.style_circles, linewidth = 2, display = display.pane)

// ───────────────────────── Zero crosses ─────────────────────────
bool crossUp = mom > 0 and mom[1] <= 0
bool crossDn = mom < 0 and mom[1] >= 0
plotshape(barstate.isconfirmed and crossUp, "Zero cross up", style = shape.triangleup, location = location.bottom, color = upStrong, size = size.tiny, display = display.pane)
plotshape(barstate.isconfirmed and crossDn, "Zero cross down", style = shape.triangledown, location = location.top, color = dnStrong, size = size.tiny, display = display.pane)

// ───────────────────────── Divergences ─────────────────────────
// Pivots of the momentum with ta.pivothigh and ta.pivotlow, divLeft bars to the left and divRight to the right,
// paired with the price of their bar, high[divRight] or low[divRight]. With divMin to divMax bars strictly
// between a pivot and the previous one of the same kind: price higher high with momentum lower high is a
// bearish divergence, price lower low with momentum higher low a bullish one. The previous pivot is replaced
// either way.
float momPh = ta.pivothigh(mom, divLeft, divRight)
float momPl = ta.pivotlow(mom, divLeft, divRight)
var float prevHiMom = na
var float prevHiPrice = na
var int prevHiBar = na
var float prevLoMom = na
var float prevLoPrice = na
var int prevLoBar = na
var array<line> divLines = array.new<line>()
var array<label> divLabels = array.new<label>()

fmtTime(int t) =>
    na(t) ? "n/a" : str.format_time(t, "yyyy-MM-dd HH:mm", syminfo.timezone)

// Draws one divergence: a line between the two momentum pivots and a mark at the second, then deletes the
// oldest beyond divKeep.
addDiv(int x1, float y1, int x2, float y2, bool bull, string tip) =>
    color c = bull ? upStrong : dnStrong
    array.push(divLines, line.new(x1, y1, x2, y2, color = c, width = 2))
    array.push(divLabels, label.new(x2, y2, bull ? "Bull" : "Bear", style = bull ? label.style_label_up : label.style_label_down, color = c, textcolor = color.white, size = size.tiny, tooltip = tip))
    while array.size(divLines) > divKeep
        line.delete(array.shift(divLines))
    while array.size(divLabels) > divKeep
        label.delete(array.shift(divLabels))

// Pivots are classified on closed bars only: on the forming bar ta.pivothigh and ta.pivotlow still read a
// momentum value that can change.
if barstate.isconfirmed
    int pivBar = bar_index - divRight
    string lag = "; confirmed " + str.tostring(divRight) + " bars after its bar, when the bar of " + fmtTime(time) + " closed."
    if not na(momPh)
        if not na(prevHiBar)
            int gap = pivBar - prevHiBar - 1
            if divOn and gap >= divMin and gap <= divMax and high[divRight] > prevHiPrice and momPh < prevHiMom
                addDiv(prevHiBar, prevHiMom, pivBar, momPh, false, "Regular bearish divergence: price higher high (" + str.tostring(high[divRight], format.mintick) + " above " + str.tostring(prevHiPrice, format.mintick) + "), momentum lower high. Pivot bar " + fmtTime(time[divRight]) + lag)
        prevHiMom := momPh
        prevHiPrice := high[divRight]
        prevHiBar := pivBar
    if not na(momPl)
        if not na(prevLoBar)
            int gap = pivBar - prevLoBar - 1
            if divOn and gap >= divMin and gap <= divMax and low[divRight] < prevLoPrice and momPl > prevLoMom
                addDiv(prevLoBar, prevLoMom, pivBar, momPl, true, "Regular bullish divergence: price lower low (" + str.tostring(low[divRight], format.mintick) + " below " + str.tostring(prevLoPrice, format.mintick) + "), momentum higher low. Pivot bar " + fmtTime(time[divRight]) + lag)
        prevLoMom := momPl
        prevLoPrice := low[divRight]
        prevLoBar := pivBar

// ───────────────────────── Alerts ─────────────────────────
// The conditions hold on closed bars only, so each fires once, at the bar's close.
alertcondition(barstate.isconfirmed and crossUp, "Momentum crossed above zero", "Squeeze momentum crossed above zero on {{ticker}} {{interval}} (closed bar).")
alertcondition(barstate.isconfirmed and crossDn, "Momentum crossed below zero", "Squeeze momentum crossed below zero on {{ticker}} {{interval}} (closed bar).")
alertcondition(barstate.isconfirmed and release, "Squeeze release", "Squeeze released on {{ticker}} {{interval}}: the Bollinger Bands left the Keltner Channel (closed bar).")
